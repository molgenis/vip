Bootstrap: localimage
From: sif/build/openjdk-25.build1.sif

%help
    Command-line application to generate a report for any VCF (Variant Call Format) file based on a report template.
    Usage: java -jar /opt/vcf-decision-tree/lib/vcf-decision-tree.jar

%post
    version_major=6
    version_minor=0
    version_patch=5

    # install
    apk add --virtual=.build-dependencies curl

    mkdir -p /opt/vcf-decision-tree/lib
    curl --fail --silent --show-error --location --output /opt/vcf-decision-tree/lib/vcf-decision-tree.jar "https://github.com/molgenis/vip-decision-tree/releases/download/v${version_major}.${version_minor}.${version_patch}/vcf-decision-tree.jar"
    echo "f82ed028dcce3a33c87993876b4e1fccdf71d5f1d1686495263348c4696378de  /opt/vcf-decision-tree/lib/vcf-decision-tree.jar" | sha256sum -c

    # cleanup
    apk del .build-dependencies
    rm -rf /var/cache/apk/*


