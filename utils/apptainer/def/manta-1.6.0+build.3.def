Bootstrap: localimage
From: sif/build/debian-13.7.sif

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -qq --no-install-recommends bzip2 ca-certificates gcc g++ make zlib1g-dev libbz2-dev wget cmake libboost-date-time-dev libboost-filesystem-dev libboost-program-options-dev libboost-regex-dev libboost-serialization-dev libboost-system-dev libboost-timer-dev libboost-chrono-dev libboost-test-dev

    # trixie has no python2 package: build Python 2.7 from source
    python_version=2.7.18
    wget https://www.python.org/ftp/python/${python_version}/Python-${python_version}.tgz
    tar -xzf Python-${python_version}.tgz
    cd Python-${python_version}
    ./configure --prefix=/opt/python2
    make -j4 install
    ln -s /opt/python2/bin/python2.7 /usr/local/bin/python2
    ln -s /opt/python2/bin/python2.7 /usr/local/bin/python
    cd ..

    version_major=1
    version_minor=6
    version_patch=0
    wget https://github.com/Illumina/manta/releases/download/v${version_major}.${version_minor}.${version_patch}/manta-${version_major}.${version_minor}.${version_patch}.release_src.tar.bz2
    tar -xjf manta-${version_major}.${version_minor}.${version_patch}.release_src.tar.bz2
    mkdir build && cd build
    ../manta-${version_major}.${version_minor}.${version_patch}.release_src/configure --jobs=4 --prefix=/opt/manta
    make -j4 install
    cd ..

    # cleanup
    rm -rf build manta-* Python-${python_version}*
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    PATH=/opt/manta/bin:/opt/python2/bin:$PATH
    
%test
    configManta.py --help > /dev/null
    python2 --version

%help
    Manta calls structural variants (SVs) and indels from mapped paired-end sequencing reads.