Bootstrap: localimage
From: sif/build/python-3.15.2.sif

%post
    version_major=2
    version_minor=1
    version_patch=4

    apt-get update > /dev/null
    apt-get install git > /dev/null

    # --only-binary              : ensure deps are not installed from source packages
    pip install \
      --only-binary=scipy,pysam,biopython,pyVCF3 \
      scipy==1.16.1 pysam==0.23.3 biopython==1.85 cigar==0.1.3 PyVCF3==1.0.4
    pip install --root-user-action=ignore --no-deps cuteSV==${version_major}.${version_minor}.${version_patch} --break-system-packages

    # cleanup
    apt-get purge git > /dev/null
    apt-get autoremove > /dev/null
    rm -rf /var/lib/apt/lists/*

%test
    set -euo pipefail
    cuteSV --help > /dev/null 2>&1

%runscript
    exec cuteSV "$@"

%help
    Long-read-based human genomic structural variation detection.
